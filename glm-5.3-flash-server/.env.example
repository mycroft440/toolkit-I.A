# GLM-5.3-Flash server configuration
MODEL_ID=zai-org/GLM-5.3-Flash
MODEL_REVISION=main
SERVED_MODEL_NAME=glm-5.3-flash
VLLM_IMAGE=vllm/vllm-openai:glm53-flash
TENSOR_PARALLEL_SIZE=8
MAX_MODEL_LEN=262144
API_PORT=8000
BIND_ADDRESS=127.0.0.1
HF_CACHE_DIR=/var/lib/glm53/huggingface
VLLM_CACHE_DIR=/var/lib/glm53/vllm-cache
VLLM_ENGINE_READY_TIMEOUT_S=3600
API_KEY=CHANGE_ME
HF_TOKEN=
ALLOWED_MEDIA_DOMAIN=media.invalid
VLLM_MEDIA_URL_ALLOW_REDIRECTS=0
